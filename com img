* {
 box-sizing: border-box;
 margin: 0;
 padding: 0;
}

body {
 display: flex;
 flex-direction: column;
 min-height: 100vh;
 background: #fff5fa;
 font-family: Arial, sans-serif;
 color: #4a2435;
}


/* cabeçalho */

.cabecalho {
 background: linear-gradient(135deg, #d94f87, #b83268);
 display: flex;
 justify-content: space-between;
 align-items: center;
 padding: 20px 50px;
 box-shadow: 0 4px 12px rgba(120, 30, 70, 0.2);
}

.cabecalho h1 {
 color: white;
 font-size: 30px;
 letter-spacing: 1px;
}

.cabecalho-link {
 color: white;
 text-decoration: none;
 font-size: 16px;
 font-weight: bold;
 padding: 8px 15px;
 border-radius: 20px;
 transition: 0.3s;
}

.cabecalho-link:hover {
 background-color: rgba(255, 255, 255, 0.2);
}


/* conteudo principal */

main {
 flex: 1;
 padding: 40px 50px 60px;
}

h2 {
 text-align: center;
 color: #9e285c;
 font-size: 25px;
 margin-bottom: 35px;
}

.cartoes {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    width: 1200px;
    max-width: 100%;
    margin: 0 auto;
}

.cartao {
    flex: 0 0 350px;
    width: 350px;
    height: 250px;
    perspective: 1000px;
}

.cartao-interno {
 position: relative;
 width: 100%;
 height: 100%;
 transition: transform 0.8s;
 transform-style: preserve-3d;
}

/* rotação do cartão */
.cartao:hover .cartao-interno {
 transform: rotateY(180deg);
}


/* frente e verso dos cards */

.cartao-frente,
.cartao-verso {
 position: absolute;
 width: 100%;
 height: 100%;
 padding: 25px;
 border-radius: 18px;
 display: flex;
 flex-direction: column;
 justify-content: center;
 align-items: center;
 text-align: center;
 backface-visibility: hidden;
  box-shadow: 0 8px 20px rgba(158, 40, 92, 0.15);
}

.cartao-frente {
 background: white;
 border: 2px solid #f0a5c3;
}

.cartao-verso {
 background: linear-gradient(135deg, #e45b91, #c93b73);
 color: white;
 transform: rotateY(180deg);
}


/* textos nos cartoes */

.titulo-cartao {
 color: #8d063c;
 font-size: 19px;
 font-weight: bold;
 margin-bottom: 18px;
}

.cartao-frente p:not(.titulo-cartao), /* ele pega todos os p dentro da class cartao frente, menos os que estao dentro da outra class titulo-cartao*/
.cartao-verso p:not(.numero) {
 font-size: 16px;
 line-height: 1.5;
}

.cartao-verso p { /* ele pega todos os p dentro da class*/
 font-weight: 500;
}


/* numero de cada flashcard */

.numero {
 position: absolute;
top: 15px;
 left: 18px;
 font-size: 13px;
 font-weight: bold;
 color: #e07aa5;
}

.cartao-verso .numero {
 color: rgba(255, 255, 255, 0.7);
}


/* rodapé */

footer {
 background-color: #b83268; padding: 18px 25px;
 color: white;
 text-align: center;
 font-size: 14px;
}



.imagem-carta {
 width: 180px;
 height: 180px;
 object-fit: cover;
 display: block;
 border-radius: 10px;
}

.separador {
 max-width: 1000px;
 margin: 50px auto 35px;
 border-top: 2px solid #f0a5c3;
 padding-top: 25px;
 text-align: center;
}

.separador h2 {
 margin: 0;
 color: #9e285c;
 font-size: 25px;
}
.cartao-experimento {
 height: 420px;
}

.cartao-experimento .cartao-verso {
    justify-content: flex-start;
    padding: 15px;
    overflow-y: auto; /* Permite rolar o texto se a tela for pequena */
}

/* Container do vídeo com proporção correta */
.video-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Proporção 16:9 */
    height: 0;
    margin-top: 20px;
    margin-bottom: 10px;
    border-radius: 8px;
    overflow: hidden;
    transform: translateZ(1px); /* Força o navegador a renderizar o vídeo dentro da camada 3D do verso */
}

.video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    border: none;
}

.cartoes {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 30px !important;
    width: 1200px !important;
    max-width: none !important;
    margin: 0 auto !important;
}

.cartao {
    width: 100% !important;
}



  
